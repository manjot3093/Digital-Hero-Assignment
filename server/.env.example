# ---------------------------------------------------------------------------
# Digital Heroes — server environment
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- Database --------------------------------------------------------------
# Supabase/Neon connection strings usually need DATABASE_SSL=true.
DATABASE_URL=postgres://dh_app:change-me@localhost:5432/digital_heroes
DATABASE_SSL=false

# --- Auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=dh_session

# --- URLs / CORS -----------------------------------------------------------
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000
# Comma-separated allowlist. Defaults to CLIENT_URL when omitted.
CORS_ORIGINS=http://localhost:5173

# --- Payments --------------------------------------------------------------
# PAYMENT_PROVIDER=stripe uses the live Stripe SDK in test mode.
# Any other value falls back to the in-memory provider used by the test suite.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=your_stripe_test_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_YEARLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx
CURRENCY=GBP

# --- Object storage for winner proof screenshots ---------------------------
# local  → files written to STORAGE_LOCAL_DIR, served via signed /api/files links
# s3     → any S3-compatible bucket (AWS S3, Cloudflare R2, Supabase Storage)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_ENDPOINT=
STORAGE_BUCKET=digital-heroes-proofs
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
STORAGE_PUBLIC_BASE_URL=
MAX_UPLOAD_BYTES=5242880

# --- Draw engine -----------------------------------------------------------
# Share of each subscription that funds the prize pool (0–1).
PRIZE_SHARE=0.5
BALL_POOL_SIZE=40
NUMBERS_PER_TICKET=5

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10
