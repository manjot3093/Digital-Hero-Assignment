# Digital Heroes — client environment
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Never put a secret here: everything in this file ships to the client.

# Base URL of the API. Leave as-is for local development; the dev server
# proxies /api to http://localhost:4000.
VITE_API_URL=/api

# Shown in the footer and in the document title.
VITE_SITE_NAME=Digital Heroes
